{
  "name": "Fondo Familiar",
  "short_name": "Fondo",
  "description": "Aportes y tesorería del Fondo Familiar",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#1e293b",
  "theme_color": "#1e293b",
  "share_target": {
    "action": "/fund/transactions/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "evidence",
          "accept": ["image/jpeg", "image/png", "application/pdf"]
        }
      ]
    }
  },
  "icons": [
    { "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/pwa-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
